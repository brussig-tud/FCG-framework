# Generated by cmake/Documentation.cmake; build the fcg-docs target.
PROJECT_NAME           = "FCG Framework"

# Pin page file names. Doxygen defaults this to NO on case-insensitive file systems, which rewrites
# CamelCase names to snake_case - a Windows run then produces struct_first_api.html where documented
# anchors such as classfcg_1_1Camera.html expect the CamelCase spelling.
CASE_SENSE_NAMES       = YES
OUTPUT_DIRECTORY       = @FCG_DOC_OUTPUT@
INPUT                  = @FCG_DOC_INPUTS@
EXAMPLE_PATH           = @FCG_DOC_EXAMPLES@
EXAMPLE_RECURSIVE      = YES
FILE_PATTERNS          = *.h *.hh *.hpp *.hxx *.dox
RECURSIVE              = NO
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_PRIV_VIRTUAL   = NO
HIDE_UNDOC_MEMBERS      = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_LATEX         = NO
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = @FCG_DOC_PREDEFINED@
HAVE_DOT              = NO
