
# Source fallbacks are compiled privately; upstream examples and installation rules stay outside the framework.
include(CheckCXXSourceCompiles)
foreach(decoder tinyobjloader tinyply)
	set(FCG_${decoder}_BUILT_HERE OFF)
	set(fcg_mesh_local OFF)
	set(mesh_decoder_download "${CPM_DOWNLOAD_ALL}")
	if(DEFINED CPM_DOWNLOAD_${decoder})
		set(mesh_decoder_download "${CPM_DOWNLOAD_${decoder}}")
	elseif(DEFINED ENV{CPM_DOWNLOAD_${decoder}})
		set(mesh_decoder_download "$ENV{CPM_DOWNLOAD_${decoder}}")
	endif()
	if(NOT mesh_decoder_download AND NOT DEFINED CPM_${decoder}_SOURCE)
		if(NOT TARGET ${decoder} AND NOT TARGET ${decoder}::${decoder})
			find_package(${decoder} QUIET CONFIG)
		endif()
		set(candidate ${decoder})
		if(TARGET ${decoder}::${decoder})
			set(candidate ${decoder}::${decoder})
		endif()
		if(TARGET ${candidate})
			get_target_property(mesh_decoder_imported ${candidate} IMPORTED)
			if(NOT mesh_decoder_imported)
				# Parent-provided build targets are checked when compiling their consumers.
				set(fcg_mesh_local ON)
			else()
				block(SCOPE_FOR VARIABLES PROPAGATE fcg_mesh_local)
					set(CMAKE_REQUIRED_LIBRARIES ${candidate})
					set(CMAKE_CXX_STANDARD 17)
					unset(FCG_MESH_${decoder}_COMPATIBLE CACHE)
					if(decoder STREQUAL "tinyply")
						check_cxx_source_compiles("#include <tinyply.h>\nint main(){tinyply::PlyData d; return d.list_sizes.size();}" FCG_MESH_${decoder}_COMPATIBLE)
					else()
						check_cxx_source_compiles("#include <tiny_obj_loader.h>\nint main(){tinyobj::callback_t c; c.vertex_color_cb = nullptr;}" FCG_MESH_${decoder}_COMPATIBLE)
					endif()
					set(fcg_mesh_local "${FCG_MESH_${decoder}_COMPATIBLE}")
				endblock()
			endif()
		endif()
	endif()
	add_library(fcg-${decoder} INTERFACE)
	if(fcg_mesh_local)
		target_link_libraries(fcg-${decoder} INTERFACE ${candidate})
		set(FCG_${decoder}_TARGET ${candidate})
	else()
		if(CPM_LOCAL_PACKAGES_ONLY)
			message(FATAL_ERROR "Mesh requires a compatible installed ${decoder}")
		endif()
		if(decoder STREQUAL "tinyply")
			CPMAddPackage(NAME tinyply GITHUB_REPOSITORY ddiakopoulos/tinyply
				GIT_TAG c9bb690dfe5e9105961e9e28120c48c9ae084bc6 DOWNLOAD_ONLY YES)
			set(decoder_include "${tinyply_SOURCE_DIR}/source")
		else()
			CPMAddPackage(NAME tinyobjloader GITHUB_REPOSITORY tinyobjloader/tinyobjloader
				GIT_TAG 2945a967c5303b2c8c14174117c45f3302591150 DOWNLOAD_ONLY YES)
			set(decoder_include "${tinyobjloader_SOURCE_DIR}")
		endif()
		add_library(fcg-${decoder}-implementation STATIC EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/../../libs/mesh/src/${decoder}.cpp")
		set_target_properties(fcg-${decoder}-implementation PROPERTIES POSITION_INDEPENDENT_CODE ON)
		target_compile_features(fcg-${decoder}-implementation PRIVATE cxx_std_17)
		target_include_directories(fcg-${decoder}-implementation SYSTEM PUBLIC "${decoder_include}")
		target_link_libraries(fcg-${decoder} INTERFACE fcg-${decoder}-implementation)
		set(FCG_${decoder}_BUILT_HERE ON)
		set(FCG_${decoder}_TARGET fcg-${decoder}-implementation)
	endif()
endforeach()
