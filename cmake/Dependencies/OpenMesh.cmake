
# OpenMesh exports no version file on several supported distributions. Check its headers instead.
set(FCG_OPENMESH_BUILT_HERE OFF)
if(NOT TARGET OpenMeshCore)
	CPMFindPackage(NAME OpenMesh
		URL https://www.graphics.rwth-aachen.de/media/openmesh_static/Releases/11.0/OpenMesh-11.0.0.tar.gz
		URL_HASH SHA256=c7f35d29673e6dbb6d65b214c10c4c6249521a8f1e8f8db6e8bdc2eed798aedc
		DOWNLOAD_ONLY YES FIND_PACKAGE_ARGUMENTS CONFIG)
	if(NOT TARGET OpenMeshCore AND OpenMesh_SOURCE_DIR)
		block(SCOPE_FOR VARIABLES)
			# Older supported checkouts predate CMake 4's removal of pre-3.5 compatibility.
			if(NOT DEFINED CMAKE_POLICY_VERSION_MINIMUM OR CMAKE_POLICY_VERSION_MINIMUM VERSION_LESS 3.5)
				set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
			endif()
			set(BUILD_APPS OFF)
			set(OPENMESH_DOCS OFF)
			set(OPENMESH_BUILD_SHARED "${BUILD_SHARED_LIBS}")
			set(CMAKE_CXX_VISIBILITY_PRESET default)
			set(CMAKE_VISIBILITY_INLINES_HIDDEN OFF)
			add_subdirectory("${OpenMesh_SOURCE_DIR}" "${OpenMesh_BINARY_DIR}" EXCLUDE_FROM_ALL)
		endblock()
		set(FCG_OPENMESH_BUILT_HERE ON)
	endif()
endif()
if(NOT TARGET OpenMeshCore)
	message(FATAL_ERROR "Mesh requires OpenMeshCore (OpenMesh 9.0 or newer)")
endif()
set(FCG_OPENMESH_TARGET OpenMeshCore)
if(NOT BUILD_SHARED_LIBS AND TARGET OpenMeshCoreStatic)
	set(FCG_OPENMESH_TARGET OpenMeshCoreStatic)
endif()
add_library(fcg-openmesh INTERFACE)
target_link_libraries(fcg-openmesh INTERFACE ${FCG_OPENMESH_TARGET})
# OpenMesh 9's static build target omits the header usage requirements supplied by its shared target.
target_include_directories(fcg-openmesh SYSTEM INTERFACE "$<TARGET_PROPERTY:OpenMeshCore,INTERFACE_INCLUDE_DIRECTORIES>")
if(WIN32)
    target_compile_definitions(fcg-openmesh INTERFACE NOMINMAX _USE_MATH_DEFINES)
endif()
get_target_property(openmesh_type ${FCG_OPENMESH_TARGET} TYPE)
if(WIN32 AND openmesh_type STREQUAL "SHARED_LIBRARY")
	target_compile_definitions(fcg-openmesh INTERFACE OPENMESHDLL)
elseif(openmesh_type STREQUAL "STATIC_LIBRARY")
	target_compile_definitions(fcg-openmesh INTERFACE OM_STATIC_BUILD)
endif()
