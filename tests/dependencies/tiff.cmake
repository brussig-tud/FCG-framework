
# All fixture sources and packages are supplied explicitly; CTest must never download dependencies.
set(SDLIMAGE_TIF ON)
set(SDLIMAGE_STRICT ON)
set(SDLIMAGE_BACKEND_IMAGEIO OFF)
set(SDLIMAGE_BACKEND_WIC OFF)
set(CPM_TIFF_SOURCE "${CMAKE_CURRENT_LIST_DIR}/tiff-source")
set(tiff_fixture_headers "${IMAGE_DEPENDENCY_SOURCE}/VisualC/external/include")
if(MODE MATCHES "^tiff-real")
    set(CPM_TIFF_SOURCE "${TEST_LIBTIFF_SOURCE}")
    set(CPM_DOWNLOAD_TIFF ON)
    if(MODE MATCHES "shared")
        set(SDLIMAGE_TIF_SHARED ON CACHE BOOL "Exercise dynamic TIFF loading")
    endif()
elseif(MODE MATCHES "^tiff-provided")
    if(MODE STREQUAL "tiff-provided-modern")
        set(tiff_fixture_target TIFF::tiff)
    elseif(MODE STREQUAL "tiff-provided-legacy")
        set(tiff_fixture_target TIFF::TIFF)
    else()
        set(tiff_fixture_target tiff)
    endif()
    add_library(${tiff_fixture_target} INTERFACE IMPORTED)
    target_include_directories(${tiff_fixture_target} INTERFACE "${tiff_fixture_headers}")
    set(CPM_TIFF_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/must-not-fetch-tiff")
elseif(MODE MATCHES "^tiff-package")
    set(tiff_package_dir "${CMAKE_CURRENT_BINARY_DIR}/tiff-package")
    file(MAKE_DIRECTORY "${tiff_package_dir}")
    file(WRITE "${tiff_package_dir}/tiff-config.cmake"
        "if(NOT TARGET TIFF::tiff)\nadd_library(TIFF::tiff INTERFACE IMPORTED)\n"
        "set_target_properties(TIFF::tiff PROPERTIES INTERFACE_INCLUDE_DIRECTORIES \"${tiff_fixture_headers}\")\nendif()\n")
    include(CMakePackageConfigHelpers)
    write_basic_package_version_file("${tiff_package_dir}/tiff-config-version.cmake"
        VERSION 4.1.0 COMPATIBILITY SameMajorVersion)
    set(TIFF_DIR "${tiff_package_dir}" CACHE PATH "Compatible installed TIFF package" FORCE)
    set(CPM_TIFF_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/must-not-fetch-tiff")
elseif(MODE MATCHES "^tiff-unresolved")
    set(CMAKE_DISABLE_FIND_PACKAGE_TIFF TRUE)
    if(NOT MODE MATCHES "strict$")
        set(SDLIMAGE_STRICT OFF)
    endif()
elseif(MODE MATCHES "^tiff-vendored|^tiff-runtime")
    # Use a stand-in SDL_image to check bypasses independently of runtime libraries and external submodules.
    set(tiff_image_fixture "${CMAKE_CURRENT_BINARY_DIR}/tiff-image")
    file(MAKE_DIRECTORY "${tiff_image_fixture}")
    set(tiff_image_config "cmake_minimum_required(VERSION 3.31)\nproject(SDL3_image VERSION 3.4.4)\n"
        "add_library(image INTERFACE)\nadd_library(SDL3_image::SDL3_image ALIAS image)\n")
    string(JOIN "" tiff_image_config ${tiff_image_config})
    foreach(codec AVIF BMP GIF JPG JXL LBM PCX PNG PNM QOI SVG TGA TIF WEBP XCF XPM XV)
        string(APPEND tiff_image_config "set(SDLIMAGE_${codec}_ENABLED OFF)\n")
    endforeach()
    string(APPEND tiff_image_config "set(SDLIMAGE_TIF_ENABLED ON)\n")
    file(WRITE "${tiff_image_fixture}/CMakeLists.txt" "${tiff_image_config}")
    set(CPM_SDL3_image_SOURCE "${tiff_image_fixture}")
    set(CPM_TIFF_SOURCE "${CMAKE_CURRENT_BINARY_DIR}/must-not-fetch-tiff")
    if(MODE STREQUAL "tiff-vendored")
        set(SDLIMAGE_VENDORED ON)
    elseif(MODE MATCHES "^tiff-runtime")
        file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/runtime-tiff" "Runtime path fixture")
        set(SDLIMAGE_DYNAMIC_TIF "${CMAKE_CURRENT_BINARY_DIR}/runtime-tiff")
        if(MODE STREQUAL "tiff-runtime-deps")
            set(SDLIMAGE_DEPS_SHARED ON)
        else()
            set(SDLIMAGE_TIF_SHARED ON)
        endif()
    endif()
else()
    set(CPM_DOWNLOAD_TIFF ON)
    if(MODE STREQUAL "tiff-shared" OR MODE STREQUAL "tiff-conflict")
        set(SDLIMAGE_TIF_SHARED ON)
        if(MODE STREQUAL "tiff-conflict")
            set(tiff-static ON CACHE BOOL "Explicitly incompatible linkage")
        endif()
    elseif(MODE STREQUAL "tiff-deps-shared")
        set(SDLIMAGE_DEPS_SHARED ON)
    elseif(MODE STREQUAL "tiff-overrides")
        set(tiff-tools ON CACHE BOOL "Explicit caller tool choice")
        set(jpeg OFF CACHE BOOL "Explicit caller compression choice")
        set(tiff-static OFF CACHE BOOL "Link a shared codec without runtime loading")
    elseif(NOT MODE STREQUAL "tiff-local" AND NOT MODE STREQUAL "tiff-cache")
        message(FATAL_ERROR "Unknown TIFF fixture mode: ${MODE}")
    endif()
endif()
if(MODE MATCHES "cache$")
    unset(SDLIMAGE_TIF)
    set(SDLIMAGE_TIF ON CACHE BOOL "Cache TIFF opt-in")
endif()
